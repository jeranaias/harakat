# Include documentation
include README.md
include LICENSE
include CHANGELOG.md
include CONTRIBUTING.md

# Include configuration
include pyproject.toml
include setup.py
include requirements.txt

# Include main module
include harakat.py
include harakat_v1.py

# Include quran module
recursive-include quran *.py *.json

# Include examples
recursive-include examples *.py *.ipynb

# Exclude development files
exclude .gitignore
exclude .pre-commit-config.yaml
prune .github
prune tests
prune experiments
prune benchmarks
prune docs
prune space
prune __pycache__
prune *.egg-info
global-exclude *.pyc
global-exclude *.pyo
global-exclude .DS_Store
